# Porta HTTP do servidor
PORT=3000

# Segredo usado para assinar os tokens. Gere um valor forte com:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo

# Validade do access_token, em segundos
JWT_EXPIRES_IN=3600

# Caminho do arquivo do banco SQLite
DB_PATH=./data/app.db
